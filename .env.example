# --- RAG / vector stores ---
PINECONE_API_KEY=...
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=...
COHERE_API_KEY=...                 # reranking / embeddings

# --- Local AI ---
OLLAMA_HOST=http://localhost:11434

# --- Automation / business (chapters 8-9) ---
