# Copy this file to .env and fill in the keys you actually use.
# Each chapter's README notes which providers it needs. Do NOT commit .env.

# --- Frontier LLM providers ---
OPENAI_API_KEY=sk-...              # GPT-5.5 / GPT-5.5 Pro / Instant, DALL-E, gpt-image-1
ANTHROPIC_API_KEY=sk-ant-...       # Claude Opus 4.8 / Sonnet 4.6 / Haiku 4.5
GOOGLE_API_KEY=...                 # Gemini 3.5 Flash / 3.1 Pro / Omni
XAI_API_KEY=xai-...                # Grok 4.3
DEEPSEEK_API_KEY=sk-...            # DeepSeek V4 Pro / V4 Flash

# --- Media / voice ---
